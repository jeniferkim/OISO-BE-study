// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

// DB 설계도
// 이 Schema를 기반으로 TypeScript 코드에서 사용할 Prisma Client를 생성하라
generator client {
  provider = "prisma-client-js"
}

// 사용할 DB 종류와 연결 주소
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 애플리케이션에서 사용할 DB 모델
model SavedRoute {
  id           Int      @id @default(autoincrement())
  title        String
  savingAmount Int
  savedAt      DateTime @default(now())

  // 실제 PostgreSQL 테이블 이름을 saved_routes로 만들겠다는 뜻
  @@map("saved_routes")
}